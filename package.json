{
  "name": "chademy-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:ctest:run": "tsx --tsconfig ./__ctest__/tsconfig.json ./__ctest__/run.ts",
    "test:ctest:events": "tsx --tsconfig ./__ctest__/tsconfig.events.json ./__ctest__/events-access.run.ts",
    "test:ctest:stripe": "tsx --test ./__ctest__/stripe-webhook-idempotency.test.ts ./__ctest__/stripe-webhook-db.integration.test.ts",
    "test:ctest:stripe-ordering": "tsx --test ./__ctest__/stripe-subscription-webhook-ordering.test.ts ./__ctest__/stripe-subscription-webhook-ordering.integration.test.ts ./__ctest__/stripe-webhook-canonical-retrieval.integration.test.ts",
    "test:ctest:admin-notes": "tsx --tsconfig ./__ctest__/tsconfig.admin-notes.json ./__ctest__/admin-user-note-delete.test.ts",
    "test:ctest:error-info": "tsx --tsconfig ./__ctest__/tsconfig.json ./__ctest__/error-information-exposure.behavior.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:ctest:admin-notes-db": "tsx --test --tsconfig ./__ctest__/tsconfig.admin-notes-db.json ./__ctest__/admin-user-note-delete.integration.test.ts"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.6.2",
    "@clerk/nextjs": "^7.3.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.12",
    "@stripe/stripe-js": "^9.4.0",
    "@vapi-ai/web": "^2.5.2",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.400.0",
    "next": "^16.2.6",
    "next-intl": "^4.11.2",
    "prisma": "^5.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-email": "^6.0.5",
    "resend": "^6.12.2",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
