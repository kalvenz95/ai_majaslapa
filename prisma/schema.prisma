generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Lietotājs ────────────────────────────────────────────────
model User {
  id               String     @id @default(cuid())
  clerkId          String     @unique
  email            String     @unique
  name             String?
  phone            String?
  avatarUrl        String?
  stripeCustomerId String?    @unique

  // Piekļuves kontrole
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  blockedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Kopiena — ierobežojums rakstīt (moderācija). null = drīkst rakstīt.
  communityRestrictedAt     DateTime?
  communityRestrictedReason String?

  subscription Subscription?
  payments     Payment[]
  progress     LessonProgress[]
  streak       UserStreak?
  posts        Post[]           @relation("PostAuthor")
  postLikes    PostLike[]       @relation("PostLikeUser")
  comments     PostComment[]    @relation("CommentAuthor")
  notes        AdminNote[]      @relation("NoteSubject")
  authoredNotes AdminNote[]     @relation("NoteAuthor")

  // Kopiena
  savedPosts            SavedPost[]             @relation("SavedByUser")
  notifications         CommunityNotification[] @relation("NotificationRecipient")
  triggeredNotifications CommunityNotification[] @relation("NotificationActor")

  // Partneru programma
  affiliate     Affiliate?       @relation("AffiliateOwner")
  referredBy    Referral?        @relation("ReferredUser")
}

// Lietotāja loma — nosaka piekļuvi admin panelim
enum Role {
  OWNER   // pilna piekļuve visam
  ADMIN   // lietotāji, kursi, maksājumi
  SUPPORT // skata lietotājus un statusus, nemaina maksājumus
  USER    // parasts lietotājs — bez admin piekļuves
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

// ── Abonements ───────────────────────────────────────────────
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan
  status               SubscriptionStatus
  stripeSubscriptionId String             @unique
  stripePriceId        String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Plan {
  PAMATI    // €29/mēn — Satura Speciālists
  IZAUGSME  // €59/mēn — AI Biznesa Automatizācija (agrāk "Digitālais Speciālists")
  MEISTARS  // €149/mēn — AI Aģentu Eksperts
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

// ── Maksājumi ────────────────────────────────────────────────
// Katrs veiksmīgs/neizdevies maksājums tiek ierakstīts šeit
// (papildus Subscription tabulai) — admin maksājumu vēsturei.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Int           // summa centos (piem. 2900 = €29.00)
  currency          String        @default("eur")
  plan              Plan?
  status            PaymentStatus @default(PENDING)
  provider          String        @default("stripe")
  providerPaymentId String?       @unique // Stripe invoice/payment intent id
  invoiceUrl        String?
  paidAt            DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
  CANCELED
}

// ── Admin piezīmes par lietotāju ─────────────────────────────
model AdminNote {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation("NoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  adminId String
  admin   User   @relation("NoteAuthor", fields: [adminId], references: [id], onDelete: Cascade)
  note    String

  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Kursi ────────────────────────────────────────────────────
model Course {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  description  String
  category     String? // piem. "Saturs", "Automatizācija"
  level        String? // piem. "Iesācējs", "Vidējais", "Pro"
  icon         String
  color        String  @default("#00ff88")
  planRequired Plan
  order        Int     @default(0)
  published    Boolean @default(false)

  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Lekcijas ─────────────────────────────────────────────────
model Lesson {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Atbalsta: YouTube unlisted, Vimeo, Mux, vai tiešs .mp4 URL
  // YouTube:  https://www.youtube.com/watch?v=VIDEO_ID
  // Vimeo:    https://vimeo.com/VIDEO_ID
  // Tiešs:    https://example.com/video.mp4
  videoUrl    String?
  duration    Int?    // sekundes
  order       Int     @default(0)
  isFree      Boolean @default(false) // preview bez abonēšanas

  progress  LessonProgress[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ── Progresa sekošana ────────────────────────────────────────
model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed      Boolean   @default(false)
  watchedSeconds Int       @default(0)
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// ── Dienu sērija ─────────────────────────────────────────────
model UserStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  totalDays      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Kopiena ───────────────────────────────────────────────────
// Piekļuve VISIEM šiem modeļiem tiek pārbaudīta `lib/community.ts`
// (requireCommunityAccess) — nekad tikai frontendā.

// Kategorijas ir DB rindas, lai admins var tās rediģēt bez deploya.
// `Post.category` glabā šīs tabulas `slug` (validēts aplikācijas pusē —
// bez FK, lai kategorijas pārsaukšana nesabojātu esošos ierakstus).
model CommunityCategory {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  emoji     String  @default("💬")
  color     String  @default("#6D5EF3")
  order     Int     @default(0)
  adminOnly Boolean @default(false) // tikai admins drīkst šeit publicēt
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Post {
  id       String  @id @default(cuid())
  authorId String
  author   User    @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title    String
  body     String
  category String  @default("diskusijas") // CommunityCategory.slug
  pinned   Boolean @default(false)
  // Admina paziņojums — izsūta notifikāciju visiem dalībniekiem
  isAnnouncement Boolean @default(false)
  editedAt DateTime?

  likes    PostLike[]
  comments PostComment[]
  media    PostMedia[]
  saves    SavedPost[]
  notifications CommunityNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, createdAt])
  @@index([pinned, createdAt])
  @@index([authorId])
}

// Attēli / video / saites, kas pievienotas ierakstam
model PostMedia {
  id     String    @id @default(cuid())
  postId String
  post   Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  type   MediaType
  url    String
  // Saites priekšskatījumam / video vāciņam
  thumbnailUrl String?
  title        String?
  description  String?
  order        Int     @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
}

enum MediaType {
  IMAGE
  VIDEO
  LINK
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body     String

  // Atbilde uz citu komentāru (viens līmenis dziļumā)
  parentId String?
  parent   PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PostComment[] @relation("CommentReplies")

  editedAt DateTime?

  notifications CommunityNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
}

// Saglabātie ieraksti ("grāmatzīmes")
model SavedPost {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SavedByUser", fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

// Kopienas paziņojumi (zvaniņš sānjoslā)
model CommunityNotification {
  id      String                    @id @default(cuid())
  userId  String                    // saņēmējs
  user    User                      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId String?                   // kas izraisīja (null = sistēma/admins)
  actor   User?                     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type    CommunityNotificationType

  postId    String?
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  read   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

enum CommunityNotificationType {
  POST_COMMENT  // kāds komentēja tavu ierakstu
  COMMENT_REPLY // kāds atbildēja uz tavu komentāru
  ANNOUNCEMENT  // admina paziņojums
}

// ── Live pasākumi (kalendārs) ─────────────────────────────────
model LiveEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  meetUrl     String?
  type        EventType @default(WEBINAR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventType {
  WEBINAR
  QA
  WORKSHOP
  OTHER
}

// ── Partneru programma (affiliate) ───────────────────────────
// Katram partnerim ir viens unikāls kods. Apmeklētājs, kas ievada
// kodu, saņem atlaidi; partneris redz cik cilvēku pievienojušies un
// iegādājušies kursus caur viņa kodu.
model Affiliate {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation("AffiliateOwner", fields: [userId], references: [id], onDelete: Cascade)
  code        String  @unique // partnera kods, piem. "KALVIS7A2"
  discountPct Int     @default(15) // atlaide %, ko saņem apmeklētājs
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals Referral[]
}

// Katrs lietotājs var būt piesaistīts tikai vienam partnera kodam.
// status JOINED  → reģistrējies ar kodu (vēl nav pircis)
// status PURCHASED → iegādājies kursu caur šo kodu
model Referral {
  id             String         @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String         @unique
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status         ReferralStatus @default(JOINED)
  plan           Plan?
  amountCents    Int            @default(0) // kopējais caur šo referral iemaksātais

  joinedAt    DateTime  @default(now())
  purchasedAt DateTime?

  @@index([affiliateId])
  @@index([status])
}

enum ReferralStatus {
  JOINED
  PURCHASED
}
